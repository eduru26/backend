# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────
# asyncpg dialect for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/ai_mentor
# sync URL used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://mentor:mentor@localhost:5432/ai_mentor

# ─── Auth (JWT HS256) ──────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MIN=60

# ─── Ollama ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
CONVERTER_URL=http://localhost:9000
DR_DOC_MODEL=qwen2.5:3b
OLLAMA_GEN_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=120
OLLAMA_TEMPERATURE=0.0

# ─── Pipeline ──────────────────────────────────────────
PIPELINE_MAX_VALIDATION_RETRIES=2
PIPELINE_COLD_START_MIN_QUESTIONS=5
PIPELINE_COLD_START_MIN_ATTENDANCE=5

# ─── Severity thresholds (Performance Agent) ───────────
SEVERITY_LOW_MIN=0.75
SEVERITY_MEDIUM_MIN=0.50
ROOT_CAUSE_LOW_ATTENDANCE_PCT=0.75
ROOT_CAUSE_WEAK_FUNDAMENTALS_PCT=0.70

# ─── Vector ────────────────────────────────────────────
VECTOR_DIM=768

# ── Textbook ingestion (docling) ──────────────────────────
# Shared on-disk path for uploaded textbook PDFs. Backend writes here on
# upload; the ingest-worker reads from the same path via the
# `textbook_pdfs` Docker volume mounted on both services. Override only
# if the compose volume target is changed.
TEXTBOOK_STORAGE_PATH=/data/textbook_pdfs

# ── Paper-gen grounding thresholds ────────────────────────
# Cosine similarity bands for the grounding validator. Below `min_sim`
# a question is rejected outright; between `min_sim` and `judge_high`
# the LLM judge gates it; at or above `judge_high` it passes without
# the extra judge call.
GROUNDING_MIN_SIM=0.45
GROUNDING_JUDGE_HIGH=0.60
